// ===== Data Model =====data class Dialogue(
    val id: Int,
    val startTime: Int, // in seconds
    val endTime: Int,
    val english: String,
    val bangla: String,
    val isShort: Boolean = false
)

// ===== Main Screen =====
@Composable
fun DialogueStudioScreen() {
    val dialogues = remember {
        listOf(
            Dialogue(1, 30, 50, "Hello, how are you doing today?", "হ্যালো, আপনি আজ কেমন আছেন?"),
            Dialogue(2, 52, 60, "Hello there!", "হ্যালো সেখানে!", isShort = true),
            Dialogue(3, 72, 90, "Let's start the project now.", "চলুন এখন প্রকল্পটি শুরু করি।"),
            Dialogue(4, 95, 115, "I've been waiting for this opportunity for months.", "আমি মাসের পর মাস এই সুযোগের জন্য অপেক্ষা করছি।"),
            Dialogue(5, 120, 125, "Thank you!", "ধন্যবাদ!", isShort = true),
            Dialogue(6, 150, 175, "We should discuss the next steps together.", "আমাদের একসাথে পরবর্তী পদক্ষেপ নিয়ে আলোচনা করা উচিত।"),
            Dialogue(7, 180, 182, "Goodbye!", "বিদায়!", isShort = true)
        )
    }

    val selectedIds = remember { mutableStateOf(setOf(1)) }
    var currentTime by remember { mutableStateOf(120f) }
    val totalTime = 300f
    var isPlaying by remember { mutableStateOf(true) }

    // Auto-play timer
    LaunchedEffect(isPlaying) {
        while (isPlaying && currentTime < totalTime) {
            delay(1000L)
            currentTime = (currentTime + 1f).coerceAtMost(totalTime)
        }
        if (currentTime >= totalTime) isPlaying = false
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(AppColors.White)
    ) {
        Column(
            modifier = Modifier.fillMaxSize()
        ) {
            HeaderSection()

            Box(modifier = Modifier.weight(1f)) {
                LazyColumn(                    modifier = Modifier
                        .fillMaxSize()
                        .padding(horizontal = 16.dp),
                    contentPadding = PaddingValues(top = 8.dp, bottom = 144.dp),
                    verticalArrangement = Arrangement.spacedBy(8.dp),
                    horizontalAlignment = Alignment.CenterHorizontally
                ) {
                    items(dialogues, key = { it.id }) { dialogue ->
                        DialogueItem(
                            dialogue = dialogue,
                            isSelected = selectedIds.value.contains(dialogue.id),
                            onClick = {
                                selectedIds.value = if (selectedIds.value.contains(dialogue.id)) {
                                    selectedIds.value - dialogue.id
                                } else {
                                    selectedIds.value + dialogue.id
                                }
                            }
                        )
                    }
                }

                // Top fade over content
                Box(
                    modifier = Modifier
                        .fillMaxWidth()
                        .height(48.dp)
                        .background(
                            Brush.verticalGradient(
                                colors = listOf(
                                    AppColors.White,
                                    AppColors.White.copy(alpha = 0.9f),
                                    AppColors.White.copy(alpha = 0.7f),
                                    AppColors.White.copy(alpha = 0.4f),
                                    AppColors.White.copy(alpha = 0.1f),
                                    Color.Transparent
                                )
                            )
                        )
                )
            }
        }

        // Footer (Audio Controller) with its fade
        Column(
            modifier = Modifier
                .fillMaxWidth()
                .align(Alignment.BottomCenter)
        ) {
            // Bottom fade            Box(
                modifier = Modifier
                    .fillMaxWidth()
                    .height(48.dp)
                    .background(
                        Brush.verticalGradient(
                            colors = listOf(
                                Color.Transparent,
                                AppColors.White.copy(alpha = 0.1f),
                                AppColors.White.copy(alpha = 0.4f),
                                AppColors.White.copy(alpha = 0.7f),
                                AppColors.White.copy(alpha = 0.9f),
                                AppColors.White
                            )
                        )
                    )
            )
            AudioController(
                currentTime = currentTime,
                totalTime = totalTime,
                isPlaying = isPlaying,
                onTimeChange = { currentTime = it },
                onPlayPauseClick = { isPlaying = !isPlaying },
                onSkipClick = { delta ->
                    currentTime = (currentTime + delta).coerceIn(0f, totalTime)
                }
            )
        }
    }
}

