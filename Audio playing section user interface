<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Word Forward - Now Playing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        /* PROFESSIONAL APPLE MUSIC STYLE SLIDER */
        input[type=range] {
            -webkit-appearance: none; 
            background: transparent; 
            width: 100%;
            margin: 0;
            padding: 0;
            cursor: pointer;
            height: 24px; /* Generous touch area */
        }
        input[type=range]:focus { outline: none; }
        
        /* Track - Thin & Minimal with Dynamic Fill */
        input[type=range]::-webkit-slider-runnable-track { 
            width: 100%; height: 4px; 
            background: linear-gradient(to right, #000 var(--progress, 0%), #e5e5e5 var(--progress, 0%));
            border-radius: 9999px; 
        }
        input[type=range]::-moz-range-track { 
            width: 100%; height: 4px; 
            background: #e5e5e5; border-radius: 9999px; 
        }
        input[type=range]::-moz-range-progress { 
            background: #000; height: 4px; border-radius: 9999px; 
        }
        
        /* Thumb - Hidden at rest, grows on touch/hover */
        input[type=range]::-webkit-slider-thumb {
            height: 4px; width: 4px; 
            border-radius: 50%;
            background: #000; 
            cursor: pointer;
            -webkit-appearance: none; 
            margin-top: 0px; 
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
            box-shadow: 0 0 0 0 rgba(0,0,0,0);
        }
        input[type=range]::-moz-range-thumb {
            height: 4px; width: 4px; 
            border: none; 
            border-radius: 50%; 
            background: #000; 
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        
        /* Reveal Thumb on Interaction */
        input[type=range]:hover::-webkit-slider-thumb,
        input[type=range]:active::-webkit-slider-thumb {
            height: 16px; width: 16px;
            margin-top: -6px; 
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }
        input[type=range]:hover::-moz-range-thumb,
        input[type=range]:active::-moz-range-thumb {
            height: 16px; width: 16px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.25);
        }
    </style>
</head>
<body class="bg-white text-black flex flex-col h-screen antialiased w-screen overflow-hidden font-sans pt-[max(1rem,env(safe-area-inset-top))] pb-[max(0.5rem,env(safe-area-inset-bottom))]">

    <audio id="main-audio" preload="metadata" src="https://www.soundhelix.com/data/mp3/SoundHelix-Song-1.mp3"></audio>

    <div id="player-shell" class="flex flex-col h-full w-full">
        <header class="px-5 pt-3 pb-3 flex items-center justify-between flex-shrink-0">
            <button class="w-10 h-10 flex items-center justify-center text-neutral-700 hover:bg-neutral-100 active:scale-95 rounded-full transition-all"><i class="fas fa-chevron-down text-base"></i></button>
            <div class="text-center">
                <p class="text-[10px] font-bold text-neutral-400 uppercase tracking-widest">Now Playing</p>
                <h2 class="text-sm font-bold text-black mt-0.5 truncate max-w-[200px]">Basic Greetings</h2>
            </div>
            <button class="w-10 h-10 flex items-center justify-center text-neutral-700 hover:bg-neutral-100 active:scale-95 rounded-full transition-all"><i class="fas fa-ellipsis text-base"></i></button>
        </header>

        <main class="flex-1 overflow-y-auto [&::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]">
            <div class="flex flex-col items-center justify-center min-h-full py-10 px-6">
                <div class="w-40 h-40 bg-gradient-to-br from-neutral-800 to-black rounded-3xl flex items-center justify-center text-white shadow-2xl mb-8">
                    <i class="fas fa-music text-5xl"></i>
                </div>
                <div class="flex flex-col items-center gap-2">
                    <h3 class="text-2xl font-extrabold text-black tracking-tight">Basic Greetings</h3>
                    <p class="text-xs text-neutral-400 max-w-xs text-center leading-relaxed">Tap play to start listening and swipe left to view translations.</p>
                </div>
            </div>
        </main>

        <div class="flex-shrink-0 bg-white px-5 pt-4 pb-2 relative z-10">
            <!-- TIMELINE WITH LEFT (CURRENT) AND RIGHT (TOTAL) LABELS -->
            <div class="flex items-center gap-3 mb-4">
                <span id="current-time" class="text-[11px] text-neutral-500 font-semibold tabular-nums w-10 text-left select-none">0:00</span>
                <input type="range" id="seek-slider" value="0" min="0" max="100" step="0.1" class="flex-1 h-6">
                <span id="total-duration" class="text-[11px] text-neutral-500 font-semibold tabular-nums w-10 text-right select-none">0:00</span>
            </div>

            <div class="flex items-center justify-center gap-6 mb-1">
                <button type="button" id="btn-back" class="text-sm font-bold text-neutral-700 hover:text-black active:scale-90 transition-all py-2 px-3 rounded-full hover:bg-neutral-100">-10s</button>
                <button type="button" id="dock-play-btn" class="px-6 py-2.5 bg-black text-white text-sm font-bold rounded-full active:scale-95 transition-transform shadow-lg flex items-center justify-center gap-2">
                    <i class="fas fa-play text-xs"></i> Play
                </button>
                <button type="button" id="btn-forward" class="text-sm font-bold text-neutral-700 hover:text-black active:scale-90 transition-all py-2 px-3 rounded-full hover:bg-neutral-100">+10s</button>
            </div>
        </div>

        <div class="flex-shrink-0 flex justify-center items-center gap-1.5 pt-2 pb-3 bg-white">
            <div class="w-4 h-1.5 rounded-full bg-black"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-neutral-300"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-neutral-300"></div>
            <div class="w-1.5 h-1.5 rounded-full bg-neutral-300"></div>
        </div>
    </div>

    <script>
        const audio = document.getElementById('main-audio');
        const playBtn = document.getElementById('dock-play-btn');
        const slider = document.getElementById('seek-slider');
        const currentTimeEl = document.getElementById('current-time');
        const totalDurationEl = document.getElementById('total-duration');
        const btnBack = document.getElementById('btn-back');
        const btnForward = document.getElementById('btn-forward');
        
        let isDragging = false;
        let knownDuration = 0;
        let durationFixed = false;

        // Smart format: "0:05" for under 10min, "1:05:30" for over 1hr
        function formatTime(sec) {
            if (!sec || isNaN(sec) || !isFinite(sec) || sec < 0) return "0:00";
            const h = Math.floor(sec / 3600);
            const m = Math.floor((sec % 3600) / 60);
            const s = Math.floor(sec % 60);
            
            if (h > 0) {
                return `${h}:${String(m).padStart(2,'0')}:${String(s).padStart(2,'0')}`;
            }
            return `${m}:${String(s).padStart(2,'0')}`;
        }

        // Helper to update visual slider fill for WebKit browsers
        function updateSliderFill() {
            const progress = (slider.value / 100) * 100;
            slider.style.setProperty('--progress', `${progress}%`);
        }

        playBtn.addEventListener('click', () => {
            if (audio.paused) {
                audio.play().catch(e => console.error("Play blocked:", e));
                playBtn.innerHTML = `<i class="fas fa-pause text-xs"></i> Pause`;
            } else {
                audio.pause();
                playBtn.innerHTML = `<i class="fas fa-play text-xs"></i> Play`;
            }
        });

        function skip(seconds) {
            let currentT = audio.currentTime || 0;
            let newTime = currentT + seconds;
            
            if (newTime < 0) newTime = 0;
            if (knownDuration > 0 && newTime > knownDuration) newTime = knownDuration;
            
            try { 
                audio.currentTime = newTime; 
            } catch(e) { console.error("Skip error:", e); }
            
            // Instant UI update
            currentTimeEl.textContent = formatTime(newTime);
            if (knownDuration > 0) {
                slider.value = (newTime / knownDuration) * 100;
                updateSliderFill();
            }
        }

        btnBack.addEventListener('click', () => skip(-10));
        btnForward.addEventListener('click', () => skip(10));

        // SMART DURATION DETECTION
        audio.addEventListener('timeupdate', () => {
            if (!isDragging && knownDuration > 0) {
                slider.value = (audio.currentTime / knownDuration) * 100;
                updateSliderFill();
            }
            currentTimeEl.textContent = formatTime(audio.currentTime);
        });

        audio.addEventListener('ended', () => {
            playBtn.innerHTML = `<i class="fas fa-play text-xs"></i> Play`;
            slider.value = 0;
            currentTimeEl.textContent = "0:00";
            updateSliderFill();
        });

        // --- ROCK-SOLID INFINITY DURATION HACK ---
        function setupDuration() {
            if (durationFixed) return; // Only run once
            
            if (isFinite(audio.duration) && audio.duration > 0) {
                knownDuration = audio.duration;
                totalDurationEl.textContent = formatTime(knownDuration);
                updateSliderFill();
                durationFixed = true;
            } else if (audio.duration === Infinity) {
                // Trick the browser by seeking to the end
                audio.currentTime = 1e101; 
                audio.addEventListener('timeupdate', defineDuration);
            }
        }

        function defineDuration() {
            if (durationFixed) return;
            audio.removeEventListener('timeupdate', defineDuration);
            
            if (isFinite(audio.duration) && audio.duration > 0) {
                knownDuration = audio.duration;
                totalDurationEl.textContent = formatTime(knownDuration);
                durationFixed = true;
            }
            
            // Reset back to 0 after tricking the browser
            try { audio.currentTime = 0; } catch(e) {}
            currentTimeEl.textContent = "0:00";
            slider.value = 0;
            updateSliderFill();
        }

        audio.addEventListener('loadedmetadata', setupDuration);
        audio.addEventListener('durationchange', setupDuration);
        audio.addEventListener('canplay', setupDuration);
        // -----------------------------------------

        // Slider Interaction
        slider.addEventListener('input', () => {
            isDragging = true;
            if (knownDuration > 0) {
                currentTimeEl.textContent = formatTime((slider.value / 100) * knownDuration);
            }
            updateSliderFill(); // Update fill while dragging
        });

        slider.addEventListener('change', () => {
            if (knownDuration > 0) {
                try { audio.currentTime = (slider.value / 100) * knownDuration; } catch(e) {}
            }
            isDragging = false;
        });

        slider.addEventListener('touchstart', () => isDragging = true, { passive: true });
        slider.addEventListener('touchend', () => {
            if (knownDuration > 0) {
                try { audio.currentTime = (slider.value / 100) * knownDuration; } catch(e) {}
            }
            isDragging = false;
        });

        // Initialize slider fill state
        updateSliderFill();
    </script>
</body>
</html>
