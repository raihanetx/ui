// ===== Dialogue Item =====
@Composable
private fun DialogueItem(
    dialogue: Dialogue,    isSelected: Boolean,
    onClick: () -> Unit
) {
    val enColor = if (isSelected) AppColors.Black else AppColors.Gray500
    val bnColor = if (isSelected) AppColors.Gray700 else AppColors.Gray400
    val enWeight = if (isSelected) FontWeight.Medium else FontWeight.Normal
    val bnWeight = if (isSelected) FontWeight.Normal else FontWeight.Normal

    Column(
        modifier = Modifier
            .fillMaxWidth()
            .clickable(onClick = onClick)
            .padding(horizontal = 16.dp, vertical = 12.dp),
        horizontalAlignment = Alignment.CenterHorizontally
    ) {
        if (dialogue.isShort) {
            // Single line: English + divider + Bangla
            Row(
                verticalAlignment = Alignment.CenterVertically,
                horizontalArrangement = Arrangement.Center
            ) {
                Text(
                    text = "[${formatTime(dialogue.startTime)}-${formatTime(dialogue.endTime)}] ",
                    fontSize = 14.sp,
                    color = enColor,
                    fontWeight = enWeight,
                    fontFamily = FontFamily.Monospace
                )
                Text(
                    text = dialogue.english,
                    fontSize = 14.sp,
                    color = enColor,
                    fontWeight = enWeight
                )
                // Divider
                Box(
                    modifier = Modifier
                        .padding(horizontal = 6.dp)
                        .width(1.dp)
                        .height(14.dp)
                        .background(AppColors.Divider)
                )
                Text(
                    text = dialogue.bangla,
                    fontSize = 14.sp,
                    color = bnColor,
                    fontWeight = bnWeight
                )
            }
        } else {            // Two lines: English on top, Bangla below
            Text(
                text = "[${formatTime(dialogue.startTime)}-${formatTime(dialogue.endTime)}] ${dialogue.english}",
                fontSize = 14.sp,
                color = enColor,
                fontWeight = enWeight,
                fontFamily = FontFamily.Monospace
            )
            Spacer(modifier = Modifier.height(2.dp))
            Text(
                text = dialogue.bangla,
                fontSize = 14.sp,
                color = bnColor,
                fontWeight = bnWeight
            )
        }
    }
}

// ===== Audio Controller =====
@Composable
private fun AudioController(
    currentTime: Float,
    totalTime: Float,
    isPlaying: Boolean,
    onTimeChange: (Float) -> Unit,
    onPlayPauseClick: () -> Unit,
    onSkipClick: (Float) -> Unit
) {
    Column(
        modifier = Modifier
            .fillMaxWidth()
            .background(AppColors.White)
            .padding(horizontal = 20.dp, vertical = 12.dp)
    ) {
        // Timeline row: time | track | time
        TimelineRow(
            currentTime = currentTime,
            totalTime = totalTime,
            isPlaying = isPlaying,
            onTimeChange = onTimeChange
        )

        Spacer(modifier = Modifier.height(12.dp))

        // Buttons
        Row(
            modifier = Modifier.fillMaxWidth(),
            horizontalArrangement = Arrangement.spacedBy(12.dp, Alignment.CenterHorizontally)
        ) {            ControlButton(
                text = "− 5s",
                isPlayButton = false,
                onClick = { onSkipClick(-5f) }
            )
            ControlButton(
                text = if (isPlaying) "Pause" else "Play",
                isPlayButton = true,
                onClick = onPlayPauseClick
            )
            ControlButton(
                text = "5s +",
                isPlayButton = false,
                onClick = { onSkipClick(5f) }
            )
        }
    }
}

// ===== Timeline Row =====
@Composable
private fun TimelineRow(
    currentTime: Float,
    totalTime: Float,
    isPlaying: Boolean,
    onTimeChange: (Float) -> Unit
) {
    val progress = (currentTime / totalTime).coerceIn(0f, 1f)

    // Pulsing animation
    val infiniteTransition = rememberInfiniteTransition(label = "pulse")
    val pulseAlpha by infiniteTransition.animateFloat(
        initialValue = 1f,
        targetValue = 0.7f,
        animationSpec = infiniteRepeatable(
            animation = tween(750, easing = EaseInOut),
            repeatMode = RepeatMode.Reverse
        ),
        label = "pulseAlpha"
    )
    val displayAlpha = if (isPlaying) pulseAlpha else 1f

    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(24.dp),
        verticalAlignment = Alignment.CenterVertically,
        horizontalArrangement = Arrangement.spacedBy(10.dp)
    ) {
        // Start time        Text(
            text = formatTime(currentTime.toInt()),
            fontSize = 11.sp,
            color = AppColors.Gray500,
            fontWeight = FontWeight.Normal,
            modifier = Modifier.width(28.dp)
        )

        // Timeline track
        Box(
            modifier = Modifier
                .weight(1f)
                .height(6.dp)
                .background(AppColors.Gray200, CircleShape)
                .pointerInput(Unit) {
                    detectTapGestures { offset ->
                        val newProgress = (offset.x / size.width).coerceIn(0f, 1f)
                        onTimeChange(newProgress * totalTime)
                    }
                }
                .pointerInput(Unit) {
                    detectDragGestures { change, _ ->
                        change.consume()
                        val newProgress = (change.position.x / size.width).coerceIn(0f, 1f)
                        onTimeChange(newProgress * totalTime)
                    }
                }
        ) {
            // Progress fill
            Box(
                modifier = Modifier
                    .fillMaxHeight()
                    .fillMaxWidth(progress)
                    .background(
                        AppColors.Black.copy(alpha = displayAlpha),
                        CircleShape
                    )
            )
        }

        // End time
        Text(
            text = formatTime(totalTime.toInt()),
            fontSize = 11.sp,
            color = AppColors.Gray500,
            fontWeight = FontWeight.Normal,
            modifier = Modifier.width(28.dp)
        )
    }
}
// ===== Control Button =====
@Composable
private fun ControlButton(
    text: String,
    isPlayButton: Boolean,
    onClick: () -> Unit
) {
    var isPressed by remember { mutableStateOf(false) }
    val bgColor = when {
        isPressed -> AppColors.ActiveBg
        else -> AppColors.White
    }
    val borderColor = if (isPlayButton) AppColors.BorderMedium else AppColors.BorderSubtle
    val fontWeight = if (isPlayButton) FontWeight.Medium else FontWeight.Normal
    val width = if (isPlayButton) 92.dp else 76.dp

    Box(
        modifier = Modifier
            .width(width)
            .height(36.dp)
            .background(bgColor, CircleShape)
            .border(1.dp, borderColor, CircleShape)
            .pointerInput(Unit) {
                detectTapGestures(
                    onPress = {
                        isPressed = true
                        tryAwaitRelease()
                        isPressed = false
                    },
                    onTap = { onClick() }
                )
            },
        contentAlignment = Alignment.Center
    ) {
        Text(
            text = text,
            fontSize = 13.sp,
            fontWeight = fontWeight,
            color = AppColors.Black,
            letterSpacing = 0.1.sp
        )
    }
}

// ===== Utility =====
private fun formatTime(seconds: Int): String {
    val min = seconds / 60
    val sec = seconds % 60
    return "$min:${sec.toString().padStart(2, '0')}"}

private val EaseInOut = CubicBezierEasing(0.42f, 0f, 0.58f, 1f)
