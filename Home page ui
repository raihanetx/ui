// ========== COLOR PALETTE (same as HTML) ==========
object HorizonColors {
    val Background = Color(0xFF121212)
    val Card = Color(0xFF1E1E1E)
    val Elevated = Color(0xFF2D2D2D)
    val Accent = Color(0xFFA052D4)
    val GradientStart = Color(0xFF667EEA)
    val GradientEnd = Color(0xFF764BA2)
    val TextPrimary = Color.White
    val TextSecondary = Color(0xFF9CA3AF)
    val TextTertiary = Color(0xFF6B7280)
    val Divider = Color(0xFF4B5563)
    val SubtitleNo = Color(0xFF6B7280)
}

// ========== DATA MODEL ==========
data class PodcastItem(    val id: Int,
    val title: String,
    val size: Int,
    val sizeText: String,
    val subtitle: String,
    val duration: String
)

// ========== MAIN ACTIVITY ==========
class MainActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        setContent {
            MaterialTheme(
                colorScheme = darkColorScheme(
                    background = HorizonColors.Background,
                    surface = HorizonColors.Card
                )
            ) {
                HorizonLoopScreen()
            }
        }
    }
}

// ========== MAIN SCREEN ==========
@Composable
fun HorizonLoopScreen() {
    val items = remember {
        listOf(
            PodcastItem(1, "The Morning Flight", 30, "30 Mb", "Yes", "24:10"),
            PodcastItem(2, "Wings of Wisdom", 52, "52 Mb", "Yes", "31:45"),
            PodcastItem(3, "Sky Melodies", 38, "38 Mb", "No", "18:20"),
            PodcastItem(4, "Dawn Chorus", 67, "67 Mb", "Yes", "42:15"),
            PodcastItem(5, "Twilight Beats", 41, "41 Mb", "No", "22:50")
        )
    }

    var filterVisible by remember { mutableStateOf(false) }
    var currentFilter by remember { mutableStateOf("All") }
    val actionStates = remember { mutableStateMapOf<Int, Boolean>() }

    val filterOptions = listOf(
        "All", "Size: Low to High", "Size: High to Low",
        "Pinned", "With Subtitle", "No Subtitle"
    )

    // Filter & Sort logic
    val displayItems = remember(currentFilter, actionStates.toMap()) {
        var result = items.toList()        when (currentFilter) {
            "Size: Low to High" -> result = result.sortedBy { it.size }
            "Size: High to Low" -> result = result.sortedByDescending { it.size }
            "Pinned" -> result = result.filter { actionStates[it.id] == true }
            "With Subtitle" -> result = result.filter { it.subtitle == "Yes" }
            "No Subtitle" -> result = result.filter { it.subtitle == "No" }
        }
        result
    }

    Box(
        modifier = Modifier
            .fillMaxSize()
            .background(HorizonColors.Background)
    ) {
        Column(
            modifier = Modifier
                .fillMaxSize()
                .padding(horizontal = 20.dp, vertical = 20.dp)
        ) {
            // ===== HEADER =====
            Header()
            Spacer(Modifier.height(24.dp))

            // ===== SEARCH BAR (fixed 48.dp height) =====
            SearchBar(
                onFilterClick = { filterVisible = !filterVisible }
            )
            Spacer(Modifier.height(16.dp))

            // ===== FILTER DROPDOWN (same 48.dp height) =====
            if (filterVisible) {
                FilterDropdown(
                    options = filterOptions,
                    selected = currentFilter,
                    onOptionSelected = { currentFilter = it }
                )
                Spacer(Modifier.height(16.dp))
            }

            // ===== CARDS LIST =====
            LazyColumn(
                verticalArrangement = Arrangement.spacedBy(16.dp)
            ) {
                items(displayItems, key = { it.id }) { item ->
                    PodcastCard(
                        item = item,
                        isPinned = actionStates[item.id] == true,
                        onPinToggle = {
                            actionStates[item.id] = !(actionStates[item.id] ?: false)                        }
                    )
                }
            }
        }
    }
}

