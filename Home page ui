// ========== SEARCH BAR (exactly 48.dp) ==========
@Composable
private fun SearchBar(onFilterClick: () -> Unit) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(48.dp)
            .clip(RoundedCornerShape(16.dp))
            .background(HorizonColors.Elevated)
            .padding(horizontal = 16.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        Icon(
            imageVector = Icons.Filled.Search,
            contentDescription = "Search",
            tint = HorizonColors.TextSecondary,
            modifier = Modifier.size(20.dp)
        )
        Spacer(Modifier.width(8.dp))
        TextField(
            value = "",
            onValueChange = {},
            placeholder = {
                Text(
                    "Search podcasts, music...",
                    color = HorizonColors.TextTertiary,
                    fontSize = 14.sp
                )
            },
            colors = TextFieldDefaults.colors(
                focusedContainerColor = Color.Transparent,
                unfocusedContainerColor = Color.Transparent,
                focusedIndicatorColor = Color.Transparent,
                unfocusedIndicatorColor = Color.Transparent,
                cursorColor = HorizonColors.Accent
            ),
            modifier = Modifier.weight(1f),
            singleLine = true
        )
        Spacer(Modifier.width(4.dp))
        Box(
            modifier = Modifier
                .size(36.dp)
                .clip(RoundedCornerShape(12.dp))
                .clickable { onFilterClick() },
            contentAlignment = Alignment.Center
        ) {
            Icon(                imageVector = Icons.Filled.Tune,
                contentDescription = "Filter",
                tint = HorizonColors.Accent,
                modifier = Modifier.size(22.dp)
            )
        }
    }
}

// ========== FILTER DROPDOWN (exactly 48.dp, same as search bar) ==========
@Composable
private fun FilterDropdown(
    options: List<String>,
    selected: String,
    onOptionSelected: (String) -> Unit
) {
    Row(
        modifier = Modifier
            .fillMaxWidth()
            .height(48.dp)
            .clip(RoundedCornerShape(16.dp))
            .background(HorizonColors.Elevated)
            .padding(horizontal = 16.dp),
        verticalAlignment = Alignment.CenterVertically
    ) {
        LazyRow(
            horizontalArrangement = Arrangement.spacedBy(20.dp),
            verticalAlignment = Alignment.CenterVertically,
            modifier = Modifier.fillMaxWidth()
        ) {
            items(options) { option ->
                val isSelected = option == selected
                val textColor by animateColorAsState(
                    if (isSelected) HorizonColors.Accent else HorizonColors.TextSecondary
                )
                Text(
                    text = option,
                    color = textColor,
                    fontSize = 14.sp,
                    fontWeight = if (isSelected) FontWeight.SemiBold else FontWeight.Medium,
                    maxLines = 1,
                    modifier = Modifier.clickable { onOptionSelected(option) }
                )
            }
        }
    }
}

// ========== PODCAST CARD ==========
@Composableprivate fun PodcastCard(
    item: PodcastItem,
    isPinned: Boolean,
    onPinToggle: () -> Unit
) {
    val gradientBrush = Brush.linearGradient(
        colors = listOf(HorizonColors.GradientStart, HorizonColors.GradientEnd)
    )

    Box(
        modifier = Modifier
            .fillMaxWidth()
            .clip(RoundedCornerShape(16.dp))
            .background(HorizonColors.Card)
            .padding(start = 20.dp, end = 8.dp, top = 16.dp, bottom = 16.dp)
    ) {
        Row(
            verticalAlignment = Alignment.CenterVertically,
            modifier = Modifier.fillMaxWidth()
        ) {
            // Icon Box
            Box(
                modifier = Modifier
                    .size(60.dp)
                    .clip(RoundedCornerShape(12.dp))
                    .background(gradientBrush),
                contentAlignment = Alignment.Center
            ) {
                Icon(
                    imageVector = Icons.Filled.Headphones,
                    contentDescription = "Podcast",
                    tint = Color.White,
                    modifier = Modifier.size(30.dp)
                )
            }

            Spacer(Modifier.width(16.dp))

            // Title + Secondary info
            Column(
                modifier = Modifier
                    .weight(1f)
                    .padding(end = 96.dp)
            ) {
                Text(
                    text = item.title,
                    color = HorizonColors.TextPrimary,
                    fontSize = 18.sp,
                    fontWeight = FontWeight.SemiBold,
                    maxLines = 1,                    overflow = TextOverflow.Ellipsis
                )
                Spacer(Modifier.height(6.dp))
                Row(
                    verticalAlignment = Alignment.CenterVertically,
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    Text(
                        text = item.sizeText,
                        color = HorizonColors.TextSecondary,
                        fontSize = 14.sp
                    )
                    Text(
                        text = "¦",
                        color = HorizonColors.Divider,
                        fontSize = 12.sp
                    )
                    Text(
                        text = "Subtitle:",
                        color = HorizonColors.TextTertiary,
                        fontSize = 14.sp
                    )
                    Text(
                        text = item.subtitle,
                        color = if (item.subtitle == "Yes") HorizonColors.Accent
                                else HorizonColors.SubtitleNo,
                        fontSize = 14.sp,
                        fontWeight = FontWeight.SemiBold
                    )
                }
            }
        }

        // Duration + Arrow — pinned to right edge (4.dp from right, centered vertically)
        Row(
            verticalAlignment = Alignment.CenterVertically,
            modifier = Modifier.align(Alignment.CenterEnd)
        ) {
            Text(
                text = item.duration,
                color = HorizonColors.TextTertiary,
                fontSize = 15.sp,
                fontWeight = FontWeight.Medium
            )
            // Arrow button — flips horizontally when pinned
            Box(
                modifier = Modifier
                    .size(36.dp)
                    .clip(RoundedCornerShape(12.dp))
                    .clickable { onPinToggle() },                contentAlignment = Alignment.Center
            ) {
                Icon(
                    imageVector = Icons.Filled.ArrowForward,
                    contentDescription = "Action",
                    tint = if (isPinned) HorizonColors.Accent else HorizonColors.TextTertiary,
                    modifier = Modifier
                        .size(24.dp)
                        .graphicsLayer {
                            scaleX = if (isPinned) -1f else 1f
                        }
                )
            }
        }
    }
}

